#!/bin/sh

set -u

self_path=$0
while [ -L "$self_path" ]; do
  link_target=$(readlink "$self_path")
  case $link_target in
    /*) self_path=$link_target ;;
    *) self_path=$(dirname "$self_path")/$link_target ;;
  esac
done
launcher="$(dirname "$self_path")/jobship"

echo "huntline is deprecated and will be removed; run jobship instead" >&2

if [ ! -x "$launcher" ]; then
  if [ "${1:-}" = "guard" ]; then
    case " $* " in
      *" --record "* | *" --self-test "*) ;;
      *)
        printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"huntline shim: the jobship launcher is missing; the Guard cannot run, so this call is denied"}}\n'
        exit 0
        ;;
    esac
  fi
  echo "huntline: the jobship launcher is missing next to this shim" >&2
  exit 1
fi

exec "$launcher" "$@"
