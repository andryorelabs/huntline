#!/bin/sh

set -u

guard_mode=0
if [ "${1:-}" = "guard" ]; then
  guard_mode=1
  for argument in "$@"; do
    case $argument in
      --record | --self-test) guard_mode=0 ;;
    esac
  done
fi

json_escape() {
  printf '%s' "$1" | tr '\n\r\t' '   ' | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

fail() {
  if [ "$guard_mode" = "1" ]; then
    reason=$(json_escape "jobship launcher: $1; the Guard cannot run, so this call is denied")
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$reason"
    exit 0
  fi
  echo "jobship: $1" >&2
  exit 1
}

checksum_for() {
  awk -v name="$1" '{ file = $2; sub(/^\*/, "", file); if (file == name) { print $1; exit } }' "$staging/SHA256SUMS"
}

self_path=$0
while [ -L "$self_path" ]; do
  link_target=$(readlink "$self_path")
  case $link_target in
    /*) self_path=$link_target ;;
    *) self_path=$(dirname "$self_path")/$link_target ;;
  esac
done
plugin_root=$(cd "$(dirname "$self_path")/.." && pwd) || fail "cannot resolve plugin root"

if [ "${JOBSHIP_FROM_SOURCE:-}" = "1" ] && command -v bun >/dev/null 2>&1; then
  exec bun "$plugin_root/src/cli.ts" "$@"
fi

manifest="$plugin_root/.claude-plugin/plugin.json"
[ -f "$manifest" ] || fail "missing $manifest"
version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" | head -n 1)
[ -n "$version" ] || fail "no version in $manifest"

cache_root=${JOBSHIP_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:-}/.cache}/jobship}
cached_binary="$cache_root/$version/jobship"

if [ ! -x "$cached_binary" ]; then
  case $(uname -s) in
    Linux) os=linux ;;
    Darwin) os=darwin ;;
    *) fail "unsupported platform $(uname -s)" ;;
  esac
  case $(uname -m) in
    x86_64 | amd64) arch=x64 ;;
    arm64 | aarch64) arch=arm64 ;;
    *) fail "unsupported architecture $(uname -m)" ;;
  esac
  asset="jobship-$os-$arch"
  base_url=${JOBSHIP_RELEASE_BASE_URL:-https://github.com/andryorelabs/jobship/releases/download}
  release_url="$base_url/v$version"
  curl_protocol_flags=""
  case "$release_url" in
    https://*) curl_protocol_flags="--proto =https --proto-redir =https" ;;
  esac

  if command -v sha256sum >/dev/null 2>&1; then
    checksum_command="sha256sum"
  elif command -v shasum >/dev/null 2>&1; then
    checksum_command="shasum -a 256"
  else
    fail "no sha256sum or shasum available to verify the download"
  fi
  command -v curl >/dev/null 2>&1 || fail "curl is required to download $asset"

  mkdir -p "$cache_root/$version" || fail "cannot create cache directory $cache_root/$version"
  staging=$(mktemp -d "$cache_root/$version/.download.XXXXXX") || fail "cannot create staging directory"
  trap 'rm -rf "$staging"' EXIT

  curl -fsL $curl_protocol_flags "$release_url/SHA256SUMS" -o "$staging/SHA256SUMS" || fail "SHA256SUMS not found at $release_url"

  expected=$(checksum_for "$asset")
  [ -n "$expected" ] || fail "no checksum listed for $asset"

  curl -fsL $curl_protocol_flags "$release_url/$asset" -o "$staging/$asset" || fail "release asset $asset not found at $release_url"
  actual=$($checksum_command "$staging/$asset" | awk '{ print $1 }')
  [ "$actual" = "$expected" ] || fail "checksum mismatch for $asset"

  chmod +x "$staging/$asset" || fail "cannot mark $asset executable"
  mv -f "$staging/$asset" "$cached_binary" || fail "cannot cache $asset"
  rmdir "$staging" 2>/dev/null || true
  trap - EXIT
fi

if [ "$guard_mode" = "0" ] && [ "${JOBSHIP_PREFETCH:-}" = "1" ]; then
  exit 0
fi

if [ "$guard_mode" = "1" ]; then
  guard_output=$("$cached_binary" "$@")
  guard_status=$?
  [ "$guard_status" -eq 0 ] || fail "the jobship binary exited with status $guard_status"
  [ -z "$guard_output" ] || printf '%s\n' "$guard_output"
  exit 0
fi

exec "$cached_binary" "$@"
