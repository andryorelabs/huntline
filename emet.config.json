{
  "$schema": "https://emet.andryore.dev/schema/emet.config.schema.json",
  "//": "Generated by `emet init` on 2026-11-09. Every value below is either autodetected or a built-in default — review before relying on it, especially repo.trunk if it was not detected (see the summary this command printed). `commands` is prose-only (see the schema) — the /emet command reads it directly, this CLI never does.",
  "version": 1,
  "repo": {
    "trunk": "develop",
    "remote": "origin"
  },
  "ticket": {
    "idPattern": "^JOB-\\d+$",
    "branchPrefix": "job"
  },
  "concurrency": {
    "waveSize": 4,
    "maxLiveWorkers": "auto",
    "runIdleThresholdMs": 5400000
  },
  "tracker": {
    "kind": "github",
    "transitions": {
      "onStart": "worker",
      "onPrOpen": "coordinator",
      "onPrMerge": "coordinator"
    },
    "github": {
      "priorityLabels": {},
      "stateLabels": {
        "todo": "status:todo",
        "in-progress": "status:in-progress",
        "in-review": "status:in-review"
      }
    }
  },
  "preflight": {
    "requiredFiles": [],
    "requiredCommands": [
      "gh",
      "bun"
    ]
  },
  "handoff": {
    "maxLines": 60,
    "maxChars": 8000,
    "autoChain": true,
    "launcher": "auto",
    "permissionMode": "bypassPermissions"
  },
  "landing": {
    "mode": "pr"
  },
  "pr": {
    "autoMerge": true,
    "mergeMethod": "squash",
    "maxCiFixAttempts": 2
  },
  "usage": {
    "oversizedReadLines": 400,
    "stalledMinutes": 10
  },
  "models": {
    "worker": {
      "model": "sonnet",
      "effort": "medium"
    },
    "reviewer": {
      "medium": {
        "model": "opus",
        "effort": "medium"
      },
      "high": {
        "model": "opus",
        "effort": "medium"
      }
    },
    "triage": "haiku",
    "escalation": {
      "sonnet": "opus"
    }
  },
  "review": {
    "highRiskPaths": []
  },
  "budgets": {
    "workerAttempts": 2,
    "reviewRounds": 2,
    "stallNudgeCap": 6
  },
  "sizing": {
    "inlineMaxLines": 100
  },
  "map": {
    "path": "docs/agents/codebase.md"
  },
  "specs": {
    "dir": "docs/specs"
  },
  "commands": {
    "selfCheck": [
      "bun run check",
      "bun run test"
    ]
  },
  "worktree": {
    "bootstrap": [
      "bun install --frozen-lockfile --silent"
    ]
  }
}
