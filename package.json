{
  "name": "jobship",
  "private": true,
  "description": "Local-first job-search system for Claude Code: a plugin plus a CLI. You press Submit.",
  "keywords": [
    "bun",
    "claude-code",
    "claude-code-plugin",
    "cli",
    "cv",
    "job-search",
    "local-first",
    "typescript"
  ],
  "homepage": "https://github.com/andryorelabs/huntline#readme",
  "bugs": {
    "url": "https://github.com/andryorelabs/huntline/issues"
  },
  "license": "MIT",
  "author": "Andry Orellana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andryorelabs/huntline.git"
  },
  "bin": {
    "huntline": "bin/huntline",
    "jobship": "bin/jobship"
  },
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip && bun run lint:docs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "bun run format && bun run lint --fix",
    "knip": "knip",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "bun tools/build-binaries.ts",
    "ci:local": "bun install --frozen-lockfile && bun run check && bun run test:coverage && bun x --no-install commitlint --from origin/main --to HEAD",
    "prepare": "husky",
    "lint:docs": "bun tools/lint-docs.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
